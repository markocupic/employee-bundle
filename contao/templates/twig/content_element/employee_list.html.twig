{% extends "@Contao/content_element/_base.html.twig" %}
{% use "@Contao/component/_figure.html.twig" %}

{% block content %}
    <div class="row">
        {% for employee in employees %}
            <div class="employee-list-item col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card">
                    {% if employee.hasImage|default %}
                        <div class="employee-image">
                            {% with {figure: employee.image} %}{{ block('figure_component') }}{% endwith %}
                        </div>
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">{{ employee.firstname }} {{ employee.lastname }}</h5>
                        <p class="card-text">{{ employee.email }}</p>
                        <p class="card-text">{{ employee.phone }}</p>
                        {% if employee.href|default %}
                            <p class="card-text"><a href="{{ employee.href }}">{{ 'MSC.more'|trans({}, 'contao_default') }}</a></p>
                        {% endif %}
                        {% if employee.hasGallery|default %}
                            <ul>
                                {% for image in employee.images %}
                                    <li>
                                        {% with {figure: image} %}{{ block('figure_component') }}{% endwith %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
