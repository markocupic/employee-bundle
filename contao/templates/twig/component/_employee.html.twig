{% use "@Contao/component/_figure.html.twig" %}

{% block employee_component %}
    {% set employee = employee|default(_context) %}

    <div class="employee-introducing">
        {% if employee.gender|default %}
            <div class="employee-gender">
                {{ 'tl_employee.gender.0'|trans({}, 'contao_default') }}: {{ employee.gender }}
            </div>
        {% endif %}

        {% if employee.title|default %}
            <div class="employee-title">
                {{ 'tl_employee.title.0'|trans({}, 'contao_default') }}: {{ employee.title }}
            </div>
        {% endif %}

        {% if employee.firstname|default %}
            <div class="employee-firstname">
                {{ 'tl_employee.firstname.0'|trans({}, 'contao_default') }}: {{ employee.firstname }}
            </div>
        {% endif %}

        {% if employee.lastname|default %}
            <div class="employee-lastname">
                {{ 'tl_employee.lastname.0'|trans({}, 'contao_default') }}: {{ employee.lastname }}
            </div>
        {% endif %}

        {% if employee.dateOfBirth_formatted|default %}
            <div class="employee-date-of-birth-formatted">
                {{ 'tl_employee.dateOfBirth.0'|trans({}, 'contao_default') }}: {{ employee.dateOfBirth_formatted }}
            </div>
        {% endif %}

        {% if employee.alias|default %}
            <div class="employee-alias">
                {{ 'tl_employee.alias.0'|trans({}, 'contao_default') }}: {{ employee.alias }}
            </div>
        {% endif %}

        {% if employee.businessHours|default %}
            <div class="employee-businessHours">
                {{ 'tl_employee.businessHours.0'|trans({}, 'contao_default') }}:<br>
                <ul>
                    {% for item in employee.businessHours %}
                        <li>
                            <span class="employee-businessHours-weekday">{{ item.weekday }}</span>
                            <span class="employee-businessHours-time">{{ item.time }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if employee.phone|default %}
            <div class="employee-phone">
                {{ 'tl_employee.phone.0'|trans({}, 'contao_default') }}: {{ employee.phone }}
            </div>
        {% endif %}

        {% if employee.mobile|default %}
            <div class="employee-mobile">
                {{ 'tl_employee.mobile.0'|trans({}, 'contao_default') }}: {{ employee.mobile }}
            </div>
        {% endif %}

        {% if employee.email|default %}
            <div class="employee-email">
                {{ 'tl_employee.email.0'|trans({}, 'contao_default') }}: {{ employee.email }}
            </div>
        {% endif %}

        {% if employee.fax|default %}
            <div class="employee-fax">
                {{ 'tl_employee.fax.0'|trans({}, 'contao_default') }}: {{ employee.fax }}
            </div>
        {% endif %}

        {% if employee.skype|default %}
            <div class="employee-skype">
                {{ 'tl_employee.skype.0'|trans({}, 'contao_default') }}: {{ employee.skype }}
            </div>
        {% endif %}

        {% if employee.linkedIn|default %}
            <div class="employee-linkedIn">
                {{ 'tl_employee.linkedIn.0'|trans({}, 'contao_default') }}: {{ employee.linkedIn }}
            </div>
        {% endif %}

        {% if employee.xing|default %}
            <div class="employee-xing">
                {{ 'tl_employee.xing.0'|trans({}, 'contao_default') }}: {{ employee.xing }}
            </div>
        {% endif %}

        {% if employee.website|default %}
            <div class="employee-website">
                {{ 'tl_employee.website.0'|trans({}, 'contao_default') }}: {{ employee.website }}
            </div>
        {% endif %}

        {% if employee.street|default %}
            <div class="employee-street">
                {{ 'tl_employee.street.0'|trans({}, 'contao_default') }}: {{ employee.street }}
            </div>
        {% endif %}

        {% if employee.postal|default %}
            <div class="employee-postal">
                {{ 'tl_employee.postal.0'|trans({}, 'contao_default') }}: {{ employee.postal }}
            </div>
        {% endif %}

        {% if employee.city|default %}
            <div class="employee-city">
                {{ 'tl_employee.city.0'|trans({}, 'contao_default') }}: {{ employee.city }}
            </div>
        {% endif %}

        {% if employee.state|default %}
            <div class="employee-state">
                {{ 'tl_employee.state.0'|trans({}, 'contao_default') }}: {{ employee.state }}
            </div>
        {% endif %}

        {% if employee.country|default %}
            <div class="employee-country">
                {{ 'tl_employee.country.0'|trans({}, 'contao_default') }}: {{ employee.country }}
            </div>
        {% endif %}

        {% if employee.countrycode_translation|default %}
            <div class="employee-countrycode_translation">
                {{ employee.countrycode_translation }}
            </div>
        {% endif %}

        {% if employee.company|default %}
            <div class="employee-company">
                {{ 'tl_employee.company.0'|trans({}, 'contao_default') }}: {{ employee.company }}
            </div>
        {% endif %}

        {% if employee.role|default %}
            <div class="employee-role">
                {{ 'tl_employee.role.0'|trans({}, 'contao_default') }}: {{ employee.role }}
            </div>
        {% endif %}

        {% if employee.roleDetail|default %}
            <div class="employee-roleDetail">
                {{ 'tl_employee.roleDetail.0'|trans({}, 'contao_default') }}: {{ employee.roleDetail|raw }}
            </div>
        {% endif %}

        {% if employee.publications|default %}
            <div class="employee-publications">
                {{ 'tl_employee.publications.0'|trans({}, 'contao_default') }}: {{ employee.publications|raw }}
            </div>
        {% endif %}

        {% if employee.interview|default %}
            <div class="employee-interview">
                {{ 'tl_employee.interview.0'|trans({}, 'contao_default') }}:<br>
                <ul>
                    {% for item in employee.interview %}
                        <li>
                            <span class="employee-interview-question">{{ item.question }}</span>
                            <span class="employee-interview-answer">{{ item.answer }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if employee.hasImage|default %}
            <div class="employee-image">
                {% with {figure: employee.image} %}{{ block('figure_component') }}{% endwith %}
            </div>
        {% endif %}

        {% if employee.hasGallery|default %}
            <ul>
                {% for image in employee.images %}
                    <li>
                        {% with {figure: image} %}{{ block('figure_component') }}{% endwith %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
